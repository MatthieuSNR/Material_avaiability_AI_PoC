# Copy to .env (never committed) and fill in.
DEEPL_API_KEY=
# LM Studio local server (OpenAI-compatible, note the /v1 suffix)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=mistralai/mistral-7b-instruct-v0.3

# Cloud summary: Mistral API (La Plateforme). Locally in this file; once deployed in the Streamlit secrets.
MISTRAL_API_KEY=
# MISTRAL_MODEL=ministral-14b-latest

# Password of the app when shared through a tunnel (empty = no password, local use)
APP_PASSWORD=

# Key of the encrypted data of the deployed app (deploy/data.enc): created by python scripts/data_bundle.py;
# also in the Streamlit Cloud secrets
DATA_KEY=
